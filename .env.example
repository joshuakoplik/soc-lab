# Copy to .env and fill in. .env is gitignored -- never commit real values.
#
# You do not need all of these. At minimum, set credentials for whichever ONE
# provider you intend to run the agents against (see pipeline/providers/), plus
# the lab service secrets at the bottom if you use those modes.

# --- Providers: pick at least one ------------------------------------------

# Anthropic API (pipeline/providers/claude.py) -- `--provider claude`
ANTHROPIC_API_KEY=

# Local models via Ollama (pipeline/providers/local.py) -- `--provider local`
# Point at wherever your Ollama server runs; http://127.0.0.1:11434 if local.
OLLAMA_HOST=
# Optional second host, if you split models across two machines.
OLLAMA_HOST_2=

# GMI (pipeline/providers/gmi.py) -- `--provider gmi`
GMI_API_KEY=
GMI_OPENAPI_HOST=

# Fireworks (pipeline/providers/fireworks.py) -- `--provider fireworks`
FIREWORKS_API_KEY=
FIREWORKS_OPENAPI_HOST=

# --- Optional agent capabilities -------------------------------------------

# Web search backend for the red-team agent's web_search tool. Omit to run
# without that tool.
TAVILY_API_KEY=

# --- Lab service secrets ---------------------------------------------------
# Any value you like -- these seed containers in this lab, nothing external.
# Generate with e.g. `openssl rand -hex 16`.

WORDPRESS_DB_PASSWORD_SECRET=
WORDPRESS_ADMIN_PASSWORD_SECRET=
WAZUH_API_PASSWORD_SECRET=

# Flag value planted in the lab's targets for the red-team agent to capture.
CTF_KEY=

# --- Host bindings ---------------------------------------------------------
# Read by compose.yaml, setup.sh, verify.sh, dashboard/server.py, and
# pipeline/redteam/agent.py (which needs the same Juice Shop port compose
# published). Container-side ports are fixed; only the host side is tunable.

# Which host interface the lab publishes on. Loopback by default, and you
# should have a specific reason before widening it: every target in this lab
# is intentionally vulnerable. Prefer one specific private-interface address
# (e.g. a WireGuard/Tailscale IP) over 0.0.0.0 if you need remote access.
LAB_BIND_IP=127.0.0.1

# Juice Shop via nginx, per mode. These must differ from each other -- two
# nginx instances cannot share a host port when both modes are up.
LAB_NGINX_EASY_PORT=8082
LAB_NGINX_HARD_PORT=8081

# Cowrie SSH honeypot. NEVER set this to 22 -- you would be handing your own
# sshd's port to a honeypot.
LAB_COWRIE_SSH_PORT=2222

# Read-only observability dashboard (dashboard/server.py).
SOC_DASHBOARD_HOST=127.0.0.1
SOC_DASHBOARD_PORT=8095
