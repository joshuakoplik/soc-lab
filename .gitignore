# Secrets -- never commit. See AGENT_BRIEF.md #4/#8: never hardcode or log the key.
.env

# Local DB and its WAL files -- generated by ingest.py, not source.
soc.db
soc.db-wal
soc.db-shm

# Runtime state written by lab-mode.sh, not source -- see pipeline/redteam/lab_modes.py.
lab_mode.json

# Python
.venv/
__pycache__/
*.pyc

# Runtime telemetry from the lab's containers -- regenerated by docker
# compose, not source. See README "Useful commands" to tail it live.
logs/

# Experiment run artifacts -- regenerable by re-running injection_asr/run_asr.py
# or pipeline/redteam/agent.py. Keep the *.md summaries (the human-readable
# conclusions); ignore the raw db/jsonl/log dumps behind them.
injection_asr/runs/*/harness.db
injection_asr/runs/*/results.jsonl
results/redteam/**/*.json
results/redteam/**/*.log
results/triage/**/*.json
results/triage/**/*.log
results/backups/

# Attacker loot -- nmap/hydra/sqlmap/shell output written per redteam
# session (see pipeline/redteam/agent.py's _loot_paths). Regenerable by
# re-running a campaign; CLAUDE.md already documents this as generated,
# not source -- this entry was just missing.
attacker/loot/
