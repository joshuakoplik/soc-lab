# Secrets -- never commit. See AGENT_BRIEF.md #4/#8: never hardcode or log the key.
.env

# Local DB and its WAL files -- generated by ingest.py, not source.
soc.db
soc.db-wal
soc.db-shm

# Runtime state written by lab-mode.sh, not source -- see pipeline/redteam/lab_modes.py.
lab_mode.json

# Python
.venv/
__pycache__/
*.pyc

# Runtime telemetry from the lab's containers -- regenerated by docker
# compose, not source. See README "Useful commands" to tail it live.
logs/

# Experiment run artifacts -- regenerable by re-running injection_asr/run_asr.py
# or pipeline/redteam/agent.py. Nothing under these is source, including the .md
# write-ups: they are one machine's numbers for one model lineup on one day, and
# anyone re-running the tools overwrites them with their own. A finding worth
# keeping outlives the run that produced it and belongs in the docs instead.
# Both directories are recreated on demand (os.makedirs(..., exist_ok=True)),
# so a fresh clone without them works fine.
injection_asr/runs/
results/

# Attacker loot -- nmap/hydra/sqlmap/shell output written per redteam
# session (see pipeline/redteam/agent.py's _loot_paths). Regenerable by
# re-running a campaign; CLAUDE.md already documents this as generated,
# not source -- this entry was just missing.
attacker/loot/

# Machine-local Claude Code permission allowlist -- per-developer, contains
# absolute paths from whichever machine it was written on. Not source.
.claude/settings.local.json
.claude/worktrees/
