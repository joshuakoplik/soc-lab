# dealer-range config -- copy to .env only if you need to override a default.
# The docker source cloned (shallow) into .cache/vulhub. Vulhub is the docker
# analog of VulnHub: github.com/vulhub/vulhub, hundreds of <software>/<CVE>
# docker-compose environments.
VULHUB_REPO=https://github.com/vulhub/vulhub.git
