# Copy to northwind-range/.env and fill in. Read by docker-compose.yml.

# REQUIRED. The operator-controlled inference host this range forwards to.
# SPEC.md §0.1/§4: llm-backend is the one deliberate egress exception in an
# otherwise fully air-gapped range, allow-listed to exactly this destination.
# Must be a raw IP, not a hostname -- nw_llm_egress has no DNS resolver.
NW_OLLAMA_UPSTREAM_HOST=
NW_OLLAMA_UPSTREAM_PORT=11434

# Optional. Which host interface edge-nginx publishes the chat app on.
# Defaults to 127.0.0.1 (loopback only). Set this to ONE specific private
# interface address -- e.g. a WireGuard/Tailscale IP -- to reach the app from
# another of your own machines. Never set it to 0.0.0.0.
#NW_EDGE_BIND_IP=127.0.0.1

# Optional. The operator harness API. Loopback by default -- SPEC.md §0.2
# allows exactly this one host-published port, and never on 0.0.0.0.
#NW_HARNESS_BIND_IP=127.0.0.1
#NW_HARNESS_PORT=8090
