# Generated -- drives password derivation (scripts/seed_entitlements.py).
# Regenerated by `make reset` if missing.
.seed

# Generated -- plaintext seeded login credentials, derived from .seed.
# Never commit: this is the only place a real login password is readable.
.seed-credentials.json

.venv/
__pycache__/
*.pyc

# ingest-svc's drive-sync watched dir -- runtime test/attacker-dropped
# content, not source. Keep the mount point itself present in git.
services/ingest-svc/watched/*
!services/ingest-svc/watched/.gitkeep
