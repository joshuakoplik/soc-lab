<!--
  Cowrie honeypot rules.

  Wazuh ships ~3000 rules but none for Cowrie: it isn't sshd, it emits its own
  JSON taxonomy. What saves us is that it emits JSON at all - Wazuh's built-in
  JSON decoder turns every key into a queryable field, so we write RULES only,
  no decoder XML.

  Field names come straight from cowrie.json keys: eventid, username, password,
  src_ip, input, session.

  REGEX DIALECT - the thing that bit us:
  <field> defaults to OS_Regex, a deliberately minimal engine with NO grouping
  parens, no '?' quantifier, no character classes. PCRE habits silently fail to
  parse, analysisd refuses to load the whole file, and every rule dies with it.
  So every field below declares type="pcre2" explicitly. Slower per event,
  irrelevant at lab volume, and it means the regex means what it looks like.

  Rule IDs: 100000+ is the reserved custom range. Never reuse a shipped SID.
-->

<group name="cowrie,">

  <!-- Base rule. level 0 = decode and group, never alert alone.
       Everything below inherits from this via if_sid. -->
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="eventid" type="pcre2">^cowrie\.</field>
    <description>Cowrie honeypot event</description>
  </rule>

  <!-- ==================== SSH authentication ==================== -->

  <rule id="100110" level="5">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.login\.failed$</field>
    <description>Cowrie: failed SSH login for user '$(username)' from $(src_ip)</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- THE rule we wanted a real SIEM for. frequency+timeframe is Wazuh's
       stateful correlation engine doing what rules.py hand-rolls in Python.
       same_field (not same_source_ip) because Cowrie's JSON key is src_ip, a
       dynamic field; same_source_ip only matches the static srcip field, which
       the JSON decoder never populates. -->
  <rule id="100111" level="10" frequency="8" timeframe="60">
    <if_matched_sid>100110</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Cowrie: SSH brute force - 8+ failed logins from $(src_ip) in 60s</description>
    <group>authentication_failures,attack,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100112" level="8">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.login\.success$</field>
    <description>Cowrie: successful SSH login for '$(username)' from $(src_ip)</description>
    <group>authentication_success,</group>
  </rule>

  <!-- Success preceded by a brute force = the attack WORKED. Highest-value
       alert the lab can produce. Composite: fires on a 100112 when 100111
       already fired for the same source inside the window. -->
  <rule id="100113" level="14" timeframe="600">
    <if_sid>100112</if_sid>
    <if_matched_sid>100111</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Cowrie: SSH brute force SUCCEEDED - '$(username)' from $(src_ip)</description>
    <group>authentication_success,attack,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- ==================== Post-compromise shell ==================== -->

  <rule id="100120" level="6">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.command\.(input|success|failed)$</field>
    <description>Cowrie: command executed: $(input)</description>
    <group>shell,</group>
  </rule>

  <rule id="100121" level="12">
    <if_sid>100120</if_sid>
    <field name="input" type="pcre2">(wget|curl|tftp)\s</field>
    <description>Cowrie: attacker downloading remote file: $(input)</description>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

  <rule id="100122" level="12">
    <if_sid>100120</if_sid>
    <field name="input" type="pcre2">/etc/(passwd|shadow)</field>
    <description>Cowrie: credential file access: $(input)</description>
    <mitre>
      <id>T1003</id>
    </mitre>
  </rule>

  <rule id="100123" level="14">
    <if_sid>100120</if_sid>
    <field name="input" type="pcre2">authorized_keys|crontab|/etc/cron</field>
    <description>Cowrie: persistence attempt: $(input)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

  <rule id="100124" level="14">
    <if_sid>100120</if_sid>
    <field name="input" type="pcre2">history\s+-c|\.bash_history</field>
    <description>Cowrie: anti-forensics, clearing history: $(input)</description>
    <mitre>
      <id>T1070</id>
    </mitre>
  </rule>

  <rule id="100125" level="10">
    <if_sid>100120</if_sid>
    <field name="input" type="pcre2">chmod\s+\+?x|base64\s+(-d|--decode)</field>
    <description>Cowrie: payload staging: $(input)</description>
  </rule>

  <!-- ==================== Session ==================== -->

  <rule id="100130" level="3">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.session\.file_download$</field>
    <description>Cowrie: file downloaded into honeypot from $(src_ip)</description>
    <group>malware,</group>
  </rule>

</group>
